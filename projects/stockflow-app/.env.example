# StockFlow — variables de entorno
# Copiar a .env.local y completar. NUNCA commitear .env.local.

# --- Supabase (proyecto PROPIO de StockFlow, separado del de StudioFlow) ---
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only: BYPASSA RLS. Sin prefijo NEXT_PUBLIC, jamás al browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Web Push (tanda 1F) ---
# Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:syntracore.studio@gmail.com

# --- Cron de alertas (tanda 1F) ---
# Secreto que valida el header de /api/cron/alerts y /api/cron/monthly-report
CRON_SECRET=

# --- Asistente IA · reporte mensual por email (PR2) ---
# Resend → API Keys. Sending access. NUNCA al browser.
RESEND_API_KEY=
# Remitente. Dev: "StockFlow <onboarding@resend.dev>" (solo entrega a tu casilla
# Resend). Prod: from de un dominio verificado, ej. "StockFlow <reportes@tudominio>".
RESEND_FROM=StockFlow <onboarding@resend.dev>
# DEV opcional: si está seteada, TODOS los reportes se redirigen a esta casilla
# (útil con el remitente compartido). En prod dejar VACÍO → va al email del dueño.
RESEND_DEV_TO=

# --- Asistente IA · narrativa del reporte (Fase 2) ---
# OPCIONAL: sin esto el reporte se manda igual, con la plantilla determinista.
# Con esto, el email suma un párrafo redactado sobre los números YA calculados
# (el modelo no calcula: toda cifra que no salga de los datos se descarta).
ANTHROPIC_API_KEY=
# Modelo. Default: claude-haiku-4-5-20251001 (el reporte es un párrafo por mes).
ANTHROPIC_MODEL=
